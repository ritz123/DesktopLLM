{
  "name": "desktopllm",
  "version": "0.11.0",
  "description": "A local-first Linux desktop chat client for Ollama and OpenRouter.",
  "author": "DesktopLLM contributors",
  "license": "GPL-3.0-only",
  "desktopName": "desktopllm",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "tsc -b && vite build",
    "electron": "electron .",
    "package": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "build": {
    "appId": "com.desktopllm.app",
    "productName": "DesktopLLM",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/**/*.AppImage",
      "!dist/linux-unpacked{,/**}",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "synopsis": "Local-first Ollama and OpenRouter chat",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
